<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgTipoIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_factura"
            android:padding="8dp"
            app:srcCompat="@android:drawable/ic_menu_agenda"
            app:tint="@android:color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvNumeroFactura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="F-2025-0002"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/tvClienteFactura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cliente: Pepe"
                android:textSize="14sp"
                android:textColor="#666666"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvTotalFactura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6050,00 €"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#4CAF50"/>

            <TextView
                android:id="@+id/tvEstadoFactura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pagada"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:background="@drawable/bg_estado_pagada"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>