<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="790.0" prefWidth="1545.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ainaraaisitaldea.controller.FacturasController">

    <!-- HEADER -->
    <top>
        <VBox style="-fx-background-color: #2196F3; -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Gestión de Facturas y Presupuestos" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#volverDashboard" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-border-color: white; -fx-border-width: 3; -fx-padding: 8 15; -fx-font-weight: bold; -fx-font-size: 13;" text="VOLVER" />

            </HBox>
        </VBox>
    </top>

    <!-- CONTENIDO -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <!-- Barra de herramientas -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">

                <Label style="-fx-font-weight: bold;" text="Filtros:" />

                <ComboBox fx:id="cmbTipo" prefWidth="150" promptText="Todos los tipos" />

                <ComboBox fx:id="cmbEstado" prefWidth="150" promptText="Todos los estados" />

                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#nuevaFactura" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-weight: bold;" text="➕ Nueva Factura" />

                <Button onAction="#nuevoPresupuesto" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-weight: bold;" text="➕ Nuevo Presupuesto" />

            </HBox>

            <!-- Tabla -->
            <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;" VBox.vgrow="ALWAYS">

                <TableView fx:id="tableFacturas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNumero" prefWidth="120" text="Número" />
                        <TableColumn fx:id="colTipo" prefWidth="100" text="Tipo" />
                        <TableColumn fx:id="colCliente" prefWidth="200" text="Cliente" />
                        <TableColumn fx:id="colFecha" prefWidth="100" text="Fecha" />
                        <TableColumn fx:id="colTotal" prefWidth="100" text="Total" />
                        <TableColumn fx:id="colEstado" prefWidth="100" text="Estado" />
                    </columns>
                </TableView>

                <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                    <Button onAction="#editarFactura" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-padding: 8 15; -fx-cursor: hand;" text="Editar" />

                    <Button onAction="#generarPDF" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 8 15; -fx-cursor: hand;" text="📄 Generar PDF" />

                    <Button onAction="#eliminarFactura" style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-padding: 8 15; -fx-cursor: hand;" text="Eliminar" />
                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>
