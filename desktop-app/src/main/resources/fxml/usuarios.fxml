<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="790.0" prefWidth="1545.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ainaraaisitaldea.controller.UsuariosController">

    <!-- HEADER -->
    <top>
        <VBox style="-fx-background-color: #2196F3; -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Gestión de Usuarios" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#volverDashboard" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-border-color: white; -fx-border-width: 3; -fx-padding: 8 15; -fx-font-weight: bold; -fx-font-size: 13;" text="VOLVER" />
            </HBox>
        </VBox>
    </top>

    <!-- CONTENIDO -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <!-- Barra de herramientas -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">

                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#nuevoUsuario" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-weight: bold;" text="➕ Nuevo Usuario" />

            </HBox>

            <!-- Tabla -->
            <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;" VBox.vgrow="ALWAYS">

                <TableView fx:id="tableUsuarios" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colUsername" prefWidth="150" text="Usuario" />
                        <TableColumn fx:id="colNombre" prefWidth="250" text="Nombre Completo" />
                        <TableColumn fx:id="colEmail" prefWidth="200" text="Email" />
                        <TableColumn fx:id="colRol" prefWidth="150" text="Rol" />
                        <TableColumn fx:id="colEstado" prefWidth="100" text="Estado" />
                    </columns>
                </TableView>

                <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                    <Button onAction="#editarUsuario" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-padding: 8 15; -fx-cursor: hand;" text="Editar" />

                    <Button onAction="#resetearPassword" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 8 15; -fx-cursor: hand;" text="🔑 Resetear Contraseña" />

                    <Button onAction="#desactivarUsuario" style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-padding: 8 15; -fx-cursor: hand;" text="❌ Desactivar" />
                </HBox>

            </VBox>

            <!-- Información -->
            <VBox spacing="10" style="-fx-background-color: #E3F2FD; -fx-padding: 15; -fx-background-radius: 5;">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #1976D2;" text="Información sobre Roles" />
                <Label style="-fx-text-fill: #1976D2;" text="• ADMINISTRADOR: Acceso total al sistema" />
                <Label style="-fx-text-fill: #1976D2;" text="• MONITOR: Solo visualización y exportación de PDFs" />
            </VBox>

        </VBox>
    </center>

</BorderPane>
