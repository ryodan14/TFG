<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="550" spacing="15" style="-fx-background-color: white; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ainaraaisitaldea.controller.UsuariosFormController">

    <Label fx:id="lblTitulo" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2196F3;" text="Nuevo Usuario" />

    <Separator />

    <GridPane hgap="15" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="140" prefWidth="140" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="350" prefWidth="380" />
        </columnConstraints>

        <!-- Username -->
        <Label text="Nombre de Usuario: *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtUsername" promptText="Usuario para login" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <!-- Contraseña (solo al crear) -->
        <Label fx:id="lblPassword" text="Contraseña: *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <PasswordField fx:id="txtPassword" promptText="Mínimo 4 caracteres" />
            <Label fx:id="lblPasswordHint" style="-fx-text-fill: #757575; -fx-font-size: 10px; -fx-font-style: italic;" text="La contraseña debe tener al menos 4 caracteres" />
        </VBox>

        <!-- Nombre Completo -->
        <Label text="Nombre Completo: *" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtNombreCompleto" promptText="Nombre y apellidos" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <!-- Email -->
        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtEmail" promptText="email@ejemplo.com" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Teléfono -->
        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="txtTelefono" promptText="943-123-456" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- Rol -->
        <Label text="Rol: *" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="5">
            <ComboBox fx:id="cmbRol" prefWidth="200" />
            <Label style="-fx-text-fill: #1976D2; -fx-font-size: 10px; -fx-font-style: italic;" text="ADMINISTRADOR: Acceso total | MONITOR: Solo visualización" />
        </VBox>

        <!-- Activo -->
        <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <CheckBox fx:id="chkActivo" selected="true" text="Usuario activo" GridPane.columnIndex="1" GridPane.rowIndex="6" />
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>

    </GridPane>

    <VBox spacing="5" style="-fx-background-color: #FFF3E0; -fx-padding: 10; -fx-background-radius: 5;">
        <Label style="-fx-font-weight: bold; -fx-text-fill: #E65100;" text="Nota Importante" />
        <Label style="-fx-text-fill: #E65100; -fx-font-size: 11px;" text="• Solo ADMINISTRADORES pueden crear y gestionar usuarios" />
        <Label style="-fx-text-fill: #E65100; -fx-font-size: 11px;" text="• La contraseña se almacena sin encriptar (según configuración)" />
    </VBox>

    <Label style="-fx-font-size: 10px; -fx-text-fill: #757575; -fx-font-style: italic;" text="* Campos obligatorios" />

    <!-- Botones -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button onAction="#guardar" prefWidth="140" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 25; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 14px;" text="💾 Guardar" />
        <Button onAction="#cerrar" prefWidth="140" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-padding: 10 25; -fx-cursor: hand; -fx-font-size: 14px;" text="❌ Cancelar" />
    </HBox>

</VBox>
