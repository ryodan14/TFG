<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" prefHeight="700" prefWidth="1000" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ainaraaisitaldea.controller.DetalleNinoController">

    <VBox spacing="25" style="-fx-padding: 30; -fx-background-color: white; -fx-pref-width: 1000;">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label fx:id="lblNombreCompleto" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #212121;" text="Nombre Completo" />
                <Label fx:id="lblEdadCurso" style="-fx-font-size: 16px; -fx-text-fill: #757575;" text="Edad - Curso" />
            </VBox>

            <Button onAction="#editarNino" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10 20; -fx-font-size: 13px; -fx-background-radius: 6;" text="Editar" />
            <Button onAction="#imprimirFicha" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10 20; -fx-font-size: 13px; -fx-background-radius: 6;" text="Imprimir Ficha" />
        </HBox>

        <Separator />

        <!-- CONTENEDOR HORIZONTAL: NIÑO + TUTOR -->
        <HBox alignment="TOP_CENTER" spacing="30">

            <!-- DATOS DEL NIÑO -->
            <VBox maxWidth="860.0" prefHeight="414.0" prefWidth="550.0" spacing="15" style="-fx-background-color: #E3F2FD; -fx-padding: 20; -fx-background-radius: 8; -fx-max-width: 470;">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1976D2;" text="Información del Participante/a" />

                <GridPane hgap="20" vgap="12">
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" wrapText="true" />
                    <Label fx:id="lblNombre" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Primer Apellido:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="lblPrimerApellido" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Segundo Apellido:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="lblSegundoApellido" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Fecha Nacimiento:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Label fx:id="lblFechaNacimiento" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Edad:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <Label fx:id="lblEdad" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Colegio/Instituto:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <Label fx:id="lblColegio" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Curso:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                    <Label fx:id="lblCurso" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Alergias:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                    <Label fx:id="lblAlergias" style="-fx-font-size: 13px; -fx-text-fill: #D32F2F; -fx-font-weight: bold;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Puede Salir Solo:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                    <Label fx:id="lblPuedeSalirSolo" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="8" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Autorización Fotos:" GridPane.columnIndex="0" GridPane.rowIndex="9" />
                    <Label fx:id="lblAutorizacionFotos" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="9" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Observaciones:" GridPane.columnIndex="0" GridPane.rowIndex="10" />
                    <Label fx:id="lblObservacionesNino" maxWidth="400" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="10" />

                    <columnConstraints>
                        <ColumnConstraints />
                        <ColumnConstraints prefWidth="100" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>
            </VBox>

            <!-- DATOS DEL TUTOR -->
            <VBox maxWidth="550.0" prefHeight="414.0" prefWidth="550.0" spacing="15" style="-fx-background-color: #FFF3E0; -fx-padding: 20; -fx-background-radius: 8; -fx-max-width: 470;">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F57C00;" text="Información del Tutor/a" />

                <GridPane hgap="20" vgap="12">
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Nombre Completo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="lblNombreTutor" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="DNI:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="lblDniTutor" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Vínculo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="lblVinculo" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Label fx:id="lblTelefonoTutor" style="-fx-font-size: 13px; -fx-text-fill: #212121; -fx-font-weight: bold;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <Label fx:id="lblCorreoTutor" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <Label fx:id="lblDireccionTutor" maxWidth="400" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Municipio:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                    <Label fx:id="lblMunicipioTutor" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Código Postal:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                    <Label fx:id="lblCodigoPostalTutor" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                    <Label style="-fx-font-size: 13px; -fx-text-fill: #616161; -fx-font-weight: bold;" text="Observaciones:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                    <Label fx:id="lblObservacionesTutor" maxWidth="400" style="-fx-font-size: 13px; -fx-text-fill: #212121;" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="8" />

                    <columnConstraints>
                        <ColumnConstraints prefWidth="120" />
                        <ColumnConstraints/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                  <RowConstraints />
                    </rowConstraints>
                </GridPane>
            </VBox>

        </HBox>

        <!-- BOTÓN CERRAR -->
        <HBox alignment="CENTER_RIGHT">
            <Button onAction="#cerrar" style="-fx-background-color: #E0E0E0; -fx-text-fill: #616161; -fx-cursor: hand; -fx-padding: 10 25; -fx-font-size: 13px; -fx-background-radius: 6;" text="Cerrar" />
        </HBox>

    </VBox>

</ScrollPane>
