<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="790.0" prefWidth="1545.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ainaraaisitaldea.controller.HinchablesController">

    <!-- HEADER -->
    <top>
        <VBox style="-fx-background-color: #2196F3; -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Economía de Hinchables" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#volverDashboard" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-border-color: white; -fx-border-width: 3; -fx-padding: 8 15; -fx-font-weight: bold; -fx-font-size: 13;" text="VOLVER" />
            </HBox>
        </VBox>
    </top>

    <!-- CONTENIDO -->
    <center>
        <VBox spacing="20" style="-fx-padding: 15;">

            <!-- Filtros y acciones -->
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">

                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Año:" />
                <ComboBox fx:id="cmbAnio" prefWidth="120" />

                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Mes:" />
                <ComboBox fx:id="cmbMes" prefWidth="150" />

                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#registrarSalida" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-weight: bold;" text="➕ Registrar Salida" />

            </HBox>

            <!-- Resumen Mensual -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2196F3;" text="Resumen Mensual" />

                <GridPane hgap="30" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints />
                        <ColumnConstraints />
                        <ColumnConstraints />
                        <ColumnConstraints />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                    </rowConstraints>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #757575; -fx-font-size: 12px;" text="Total de Salidas" />
                        <Label fx:id="lblTotalActividades" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2196F3;" text="0" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #757575; -fx-font-size: 12px;" text="Total Ingresos" />
                        <Label fx:id="lblTotalIngresos" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" text="0.00 €" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #757575; -fx-font-size: 12px;" text="Total Gastos" />
                        <Label fx:id="lblTotalGastos" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #F44336;" text="0.00 €" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #757575; -fx-font-size: 12px;" text="Beneficio Neto" />
                        <Label fx:id="lblBeneficioNeto" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="0.00 €" />
                    </VBox>

                </GridPane>

            </VBox>

            <!-- Tabla de Salidas -->


            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;" VBox.vgrow="ALWAYS">

                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Detalle de Salidas" />

                <TableView fx:id="tableHinchables" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFechaDia" prefWidth="220" text="Fechas" />
                        <TableColumn fx:id="colNombre" prefWidth="250" text="Nombre/Descripción" />
                        <TableColumn fx:id="colHorarioDia" prefWidth="220" text="Horarios" />
                        <TableColumn fx:id="colObservaciones" prefWidth="390" text="Observaciones" />
                        <TableColumn fx:id="colIngresos" prefWidth="120" text="Ingresos" />
                        <TableColumn fx:id="colGastos" prefWidth="150" text="Gastos Monitores" />
                        <TableColumn fx:id="colBeneficio" prefWidth="100" text="Beneficio" />
                    </columns>
                </TableView>

                <HBox spacing="10">
                    <Button onAction="#editarSalida" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-padding: 8 15; -fx-cursor: hand;" text="Editar Salida" />
                    <Button onAction="#eliminarSalida" style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-padding: 8 15; -fx-cursor: hand;" text="Eliminar Salida" />
                </HBox>

            </VBox>

            <!-- Resumen Anual -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #FF9800;" text="Resumen Anual" />
                    <Region HBox.hgrow="ALWAYS" />

                    <!-- NUEVO: Botón Exportar PDF Anual -->
                    <Button onAction="#exportarPDFAnual" style="-fx-background-color: #FF5722; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-weight: bold;" text="📄 Exportar PDF Anual Completo" />
                </HBox>

                <GridPane hgap="30" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints />
                        <ColumnConstraints />
                        <ColumnConstraints />
                        <ColumnConstraints />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                    </rowConstraints>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #757575; -fx-font-size: 12px;" text="Total de Salidas" />
                        <Label fx:id="lblTotalActividadesAnual" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #FF9800;" text="0" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #757575; -fx-font-size: 12px;" text="Total Ingresos" />
                        <Label fx:id="lblTotalIngresosAnual" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" text="0.00 €" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #757575; -fx-font-size: 12px;" text="Total Gastos" />
                        <Label fx:id="lblTotalGastosAnual" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #F44336;" text="0.00 €" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #757575; -fx-font-size: 12px;" text="Beneficio Neto" />
                        <Label fx:id="lblBeneficioNetoAnual" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="0.00 €" />
                    </VBox>

                </GridPane>

            </VBox>

        </VBox>
    </center>

</BorderPane>
