<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="600" spacing="15" style="-fx-background-color: white; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ainaraaisitaldea.controller.ActividadFormController">

    <Label fx:id="lblTitulo" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2196F3;" text="Nueva Actividad" />

    <Separator />

    <ScrollPane fitToWidth="true" style="-fx-background-color: white;">
        <VBox spacing="15">

            <GridPane hgap="15" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="130" prefWidth="130" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="400" prefWidth="450" />
                </columnConstraints>

                <!-- Tipo de Actividad -->
                <Label text="Tipo: *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="cmbTipo" prefWidth="9999" promptText="Seleccione tipo de actividad" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <!-- Nombre -->
                <Label text="Nombre: *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtNombre" promptText="Nombre de la actividad" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <!-- Fecha -->
                <Label text="Fecha: *" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <DatePicker fx:id="dpFecha" prefWidth="9999" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <!-- Hora Inicio -->
                <Label text="Hora Inicio: *" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <TextField fx:id="txtHoraInicio" prefWidth="150" promptText="HH:MM (Ej: 18:00)" />
                    <Label alignment="CENTER_LEFT" style="-fx-text-fill: #757575; -fx-font-size: 11px;" text="Formato: 24 horas (18:00)" />
                </HBox>

                <!-- Hora Fin -->
                <Label text="Hora Fin: *" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <TextField fx:id="txtHoraFin" prefWidth="150" promptText="HH:MM (Ej: 20:00)" />
                    <Label alignment="CENTER_LEFT" style="-fx-text-fill: #757575; -fx-font-size: 11px;" text="Formato: 24 horas (20:00)" />
                </HBox>

                <!-- Descripción (solo para tipo OTRAS) -->
                <Label fx:id="lblDescripcion" managed="false" text="Descripción:" visible="false" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.valignment="TOP">
                    <padding><Insets top="5" /></padding>
                </Label>
                <TextArea fx:id="txtDescripcion" managed="false" prefRowCount="2" promptText="Descripción de la actividad..." visible="false" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                <!-- Monitores Asignados -->
                <Label text="Monitores:" GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.valignment="TOP">
                    <padding><Insets top="5" /></padding>
                </Label>
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="6">
                    <ListView fx:id="listMonitoresDisponibles" prefHeight="120" style="-fx-border-color: #E0E0E0; -fx-border-radius: 5;" />
                    <Label style="-fx-text-fill: #757575; -fx-font-size: 10px; -fx-font-style: italic;" text="Mantén Ctrl/Cmd para seleccionar múltiples monitores" />
                </VBox>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>

            </GridPane>

            <!-- Separador para Hinchables -->
            <VBox fx:id="paneHinchables" managed="false" spacing="10" style="-fx-background-color: #FFF3E0; -fx-padding: 15; -fx-background-radius: 5;" visible="false">

                <Label style="-fx-font-weight: bold; -fx-text-fill: #E65100;" text="💰 Información Económica (Hinchables)" />

                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130" prefWidth="130" />
                        <ColumnConstraints minWidth="150" prefWidth="200" />
                    </columnConstraints>

                    <Label text="Dinero Recibido:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtDineroRecibido" prefWidth="150" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Pagado a Monitores:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="txtDineroPagado" prefWidth="150" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label style="-fx-font-weight: bold;" text="Beneficio:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="lblBeneficio" style="-fx-font-weight: bold; -fx-text-fill: green;" text="0.00 €" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>
            </VBox>

            <!-- Observaciones / Recordatorio -->
            <VBox spacing="5">
                <Label style="-fx-font-weight: bold;" text="Observaciones / Recordatorio:" />
                <TextArea fx:id="txtObservaciones" prefRowCount="3" promptText="Notas, recordatorios, información adicional..." />
            </VBox>

            <!-- Repetir Semanalmente -->
            <VBox spacing="10" style="-fx-background-color: #E3F2FD; -fx-padding: 15; -fx-background-radius: 5;">
                <CheckBox fx:id="chkRepetirSemanal" style="-fx-font-weight: bold; -fx-text-fill: #1976D2;" text="🔄 Repetir esta actividad semanalmente" />

                <VBox fx:id="paneRepeticion" managed="false" spacing="10" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-weight: bold;" text="Repetir durante:" />
                        <TextField fx:id="txtSemanas" prefWidth="150" promptText="Número de semanas" />
                        <Label text="semanas (incluyendo la actual)" />
                    </HBox>
                    <Label style="-fx-text-fill: #1976D2; -fx-font-size: 11px; -fx-font-style: italic;" text="Ejemplo: Si introduces 4, se crearán actividades para las próximas 4 semanas." />
                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>

    <Label style="-fx-font-size: 10px; -fx-text-fill: #757575; -fx-font-style: italic;" text="* Campos obligatorios" />

    <!-- Botones -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button onAction="#guardar" prefWidth="140" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 25; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 14px;" text="Guardar" />
        <Button onAction="#cerrar" prefWidth="140" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-padding: 10 25; -fx-cursor: hand; -fx-font-size: 14px;" text="Cancelar" />
    </HBox>

</VBox>
