<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.ainaraaisitaldea.controller.FacturasFormController"
      spacing="15" style="-fx-background-color: white; -fx-padding: 20;"  prefHeight="790.0" prefWidth="650">

    <!-- ToggleGroup DEFINIDO correctamente -->
    <fx:define>
        <ToggleGroup fx:id="grupoTipo"/>
    </fx:define>

    <Label fx:id="lblTitulo" text="Nueva Factura"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>

    <Separator/>

    <ScrollPane fitToWidth="true" style="-fx-background-color: white;">
        <VBox spacing="15">

            <!-- Tipo de Documento -->
            <HBox spacing="20"
                  alignment="CENTER_LEFT"
                  style="-fx-background-color: #E3F2FD; -fx-padding: 15; -fx-background-radius: 5;">

                <Label text="Tipo de Documento:" style="-fx-font-weight: bold;" />

                <!-- Aquí YA funciona correctamente el ToggleGroup -->
                <RadioButton fx:id="rbFactura" text="Factura" toggleGroup="$grupoTipo" selected="true"/>
                <RadioButton fx:id="rbPresupuesto" text="Presupuesto" toggleGroup="$grupoTipo"/>

            </HBox>

            <GridPane hgap="15" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="150" prefWidth="150"/>
                    <ColumnConstraints minWidth="400" prefWidth="470" hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Número (solo lectura) -->
                <Label text="Número:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNumero" editable="false"
                           promptText="Se generará automáticamente"
                           style="-fx-background-color: #F5F5F5;"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <!-- Cliente -->
                <Label text="Cliente: *" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtCliente" promptText="Nombre o razón social del cliente"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <!-- NIF -->
                <Label text="NIF/CIF:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtNIF" promptText="NIF o CIF del cliente"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <!-- Dirección -->
                <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                       GridPane.valignment="TOP">
                    <padding><Insets top="5"/></padding>
                </Label>
                <TextArea fx:id="txtDireccion" promptText="Dirección completa del cliente..."
                          prefRowCount="2" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <!-- Fecha Emisión -->
                <Label text="Fecha Emisión: *" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <DatePicker fx:id="dpFechaEmision" GridPane.columnIndex="1" GridPane.rowIndex="4"
                            prefWidth="9999"/>

                <!-- Fecha Vencimiento -->
                <Label text="Fecha Vencimiento:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <DatePicker fx:id="dpFechaVencimiento" GridPane.columnIndex="1" GridPane.rowIndex="5"
                            prefWidth="9999"/>

                <!-- Concepto -->
                <Label text="Concepto: *" GridPane.columnIndex="0" GridPane.rowIndex="6"
                       GridPane.valignment="TOP">
                    <padding><Insets top="5"/></padding>
                </Label>
                <TextArea fx:id="txtConcepto" promptText="Descripción detallada de los servicios/productos..."
                          prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

            </GridPane>

            <!-- Importes -->
            <VBox spacing="10" style="-fx-background-color: #FFF3E0; -fx-padding: 15; -fx-background-radius: 5;">

                <Label text="💰 Importes" style="-fx-font-weight: bold; -fx-text-fill: #E65100; -fx-font-size: 14px;"/>

                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150" prefWidth="150"/>
                        <ColumnConstraints minWidth="150" prefWidth="200"/>
                        <ColumnConstraints minWidth="100"/>
                    </columnConstraints>

                    <!-- Base Imponible -->
                    <Label text="Base Imponible: *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtBaseImponible" promptText="0.00"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="€" GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                    <!-- IVA -->
                    <Label text="IVA (%):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2">
                        <TextField fx:id="txtIVA" promptText="21" prefWidth="100"/>
                        <Label text=" %"/>
                        <Label text="Cantidad IVA:" style="-fx-padding: 0 0 0 20;"/>
                        <Label fx:id="lblIVACantidad" text="0.00 €"
                               style="-fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
                    </HBox>

                    <!-- Total -->
                    <Label text="TOTAL:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                           style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label fx:id="lblTotal" text="0.00 €"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"
                           style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #4CAF50;"/>

                </GridPane>
            </VBox>

            <!-- Estado -->
            <VBox spacing="5">
                <Label text="Estado:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="cmbEstado" prefWidth="200"/>
            </VBox>

            <!-- Observaciones -->
            <VBox spacing="5">
                <Label text="Observaciones:" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="txtObservaciones" promptText="Notas adicionales..."
                          prefRowCount="2"/>
            </VBox>

        </VBox>
    </ScrollPane>

    <Label text="* Campos obligatorios"
           style="-fx-font-size: 10px; -fx-text-fill: #757575; -fx-font-style: italic;"/>

    <!-- Botones -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="💾 Guardar" onAction="#guardar"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 25; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 14px;"
                prefWidth="140"/>
        <Button text="❌ Cancelar" onAction="#cerrar"
                style="-fx-background-color: #757575; -fx-text-fill: white; -fx-padding: 10 25; -fx-cursor: hand; -fx-font-size: 14px;"
                prefWidth="140"/>
    </HBox>

</VBox>
